# IDE
.vs/
.idea/
.vscode/
*.code-workspace

# 本地的调试 / 一次性补丁脚本（根目录下划线开头的那批），不进仓库
/_*.py
/_*.log

# 编辑器记忆与本地会话数据（含本机绝对路径），不进仓库
.workbuddy/

# 压缩包 / 临时输出
*.zip
*.7z

# WebGL 构建产物
BuildWebGL/

# 编辑器本机的包管理器注册表配置（含镜像地址，因人而异）
ProjectSettings/PackageManagerSettings.asset

# 发布用的整理目录（由 BuildWebGL 拷出来、Build 改名 game），不进货仓
WebDeploy/

# 已发布应用的标记文件（本地记录用，不进仓库）
.wbapp_*.genie

# 素材备份（字体原文件、字符表等，只在本地留档）
_backup/

# 安卓打包产物
BuildAndroid/

# 安装包 / 免安装包产物，以及打安装包时的临时目录
BuildInstaller/
.msi-tmp/
